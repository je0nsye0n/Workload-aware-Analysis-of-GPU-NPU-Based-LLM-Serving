```gitignore
# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
.venv-gpu/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Jupyter Notebook
.ipynb_checkpoints/

# Build / Distribution
build/
dist/
*.egg-info/
.eggs/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak

# Model checkpoints / large artifacts
*.pt
*.pth
*.ckpt
*.safetensors
*.bin

# Hugging Face cache
.cache/
huggingface/
serve_logs/
```